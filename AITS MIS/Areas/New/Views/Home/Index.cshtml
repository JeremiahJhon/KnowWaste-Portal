<!---News section-->
<section class="pt-120 pb-60">
    <div class="container">
        <h2 class="section-title">Latest News</h2>

        <!---blog card section--->
        <div class="blog-card-grid pt-4">
            @foreach (ViewModels.News item in Model.NewsList.Take(4))
            {
                <a href="New/News/Details/@item.ID" class="blog-card">
                    <div class="blog-card-image">
                        <img src="~/Documents/News/@item.Photo.Split(';')[0]" alt="">
                    </div>

                    <div class="blog-card-content">
                        <h3>@item.Title</h3>
                        <div class="blog-card-meta meta">
                            <div class="meta-item">
                                <i class="bi bi-calendar3 meta-icon"></i>
                                <span>@Convert.ToDateTime(item.Date.Trim().Split('-')[0]).ToString("MMMM d, yyyy") - @Convert.ToDateTime(item.Date.Trim().Split('-')[1]).ToString("MMMM d, yyyy")</span>
                            </div>
                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                <span>@item.Country</span>
                            </div>
                        </div>
                        <div class="card-text text-truncate-3" style="max-height: 80px">
                            @Html.Raw((System.Text.RegularExpressions.Regex.Replace(item.Description, "<.*?>", "").Length > 80) ?
                                              System.Text.RegularExpressions.Regex.Replace(item.Description, "<.*?>", "").Substring(0, 80) + "..."
                                              :
                                              System.Text.RegularExpressions.Regex.Replace(item.Description, "<.*?>", ""))
                        </div>
                        <span class="blog-card-arrow">→</span>
                    </div>
                </a>
            }
        </div>
        <div class="text-center mt-4">
            <a href="New/News" class="btn-main">See News</a>
        </div>
    </div>
</section> <!---end of news -->
<!---publications -->
<section class="pt-60 pb-60 bg-peach-cream">
    <div class="container">
        <h2 class="section-title">Publications</h2>

        <!---publication -list --->
        <div class="publication-list home-publication">

            @foreach (ViewModels.Document item in Model.DocumentList.Take(5))
            {
                <!-- DOCUMENT ITEM -->
                <a href="~/Documents/@item.Attachment.Split(';')[0]" class="publication-item" target="_blank">

                    <div class="publication-image">
                        <img src="/Documents/@item.Thumbnail" alt="@item.Title">
                    </div>

                    <div class="publication-content">
                        <h3 class="publication-title">
                            @item.Title
                        </h3>

                        <div class="publication-meta meta">

                            <div class="meta-item">
                                <i class="bi bi-calendar3 meta-icon"></i>
                                <span>@item.Year</span>
                            </div>

                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                <span>@item.Country</span>
                            </div>

                            <div class="meta-item">
                                <i class="bi bi-building meta-icon"></i>
                                <span>@item.Publisher</span>
                            </div>

                        </div>

                        <div class="document-desc">
                            @Html.Raw(item.Description)
                        </div>

                        <!-- NOT a link anymore -->
                        <span class="btn-secondary-main">

                            <span>View Document</span>

                            <span class="download-icon">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M12 3V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M5 19H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                            </span>
                        </span>
                    </div>
                </a>
                <!-- END DOCUMENT ITEM -->
            }
        </div>
        <div class="text-center mt-4">
            <a href="New/Publications" class="btn-main">See all Publications</a>
        </div>
    </div>
</section> <!---end of publications -->
<!---good practices -->
<section class="pt-60 pb-60">
    <div class="container">
        <h2 class="section-title">Good Practices</h2>

        <!---blog card section--->
        <div class="blog-card-grid">

            @foreach (ViewModels.GoodPractice item in Model.BlogList.Take(4))
            {
                <a href="New/GoodPractices/Details/@item.ID" class="blog-card">
                    <div class="blog-card-image">
                        <img src="Documents/Blogs/@item.Thumbnail.Split(';')[0]"
                             class="card-img-top"
                             alt="@item.Title">
                    </div>

                    <div class="blog-card-content">
                        <h3>@item.Title</h3>

                        <div class="blog-card-meta meta">
                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                @item.Country
                            </div>
                        </div>

                        <div class="card-text text-truncate-3" style="max-height: 80px">@Html.Raw(item.Description)</div>
                        <span class="blog-card-arrow">→</span>
                    </div>
                </a>
            }
        </div><!---end of card grid ---->
        <div class="text-center mt-4">
            <a href="New/GoodPractices" class="btn-main">See all Good Practices</a>
        </div>
    </div>
</section><!--end of good practices-->

<section class="pt-60 pb-60 bg-light-blue">
    <div class="container">
        <h2 class="section-title">Meet the Experts</h2>
        <div class="container">
            <div class="owl-carousel owl-theme meet-the-experts expert-grid" id="meet-the-experts">
                @foreach (ViewModels.Expert item in Model.ExpertList)
                {
                    var fileName = item.Thumbnail.Split(';')[0];
                    var filePath = Server.MapPath("~/Documents/" + fileName);
                    <a href="/New/Experts#@item.Name.Replace(" ","")" class="card expert-card mx-2">
                        @if (File.Exists(filePath))
                        {
                            <div class="expert-image">
                                <img src="Documents/@item.Thumbnail.Split(';')[0]" alt="@item.Name">
                            </div>
                        }
                        else
                        {
                            <div class="expert-image">
                                <img src="~/Content/new-template/images/expert-profile.png" alt="@item.Name">
                            </div>
                        }
                        <div class="expert-content">
                            <h3 class="text-truncate">@item.Name</h3>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .owl-stage {
        margin-top: 25px;
        margin-bottom: 25px;
    }
</style>

@section scripts{
    <script>
        $(function () {
            $("#meet-the-experts").owlCarousel({
                items: 4,
                loop: true,
                autoplay: true,
                autoplayTimeout: 3000,
                autoplayHoverPause: false,
                responsive: {
                    0: {
                        items: 1
                    },
                    600: {
                        items: 3
                    },
                    1000: {
                        items: 4
                    },
                    1200: {
                        items: 4
                    }
                }
            });
        });
    </script>
}