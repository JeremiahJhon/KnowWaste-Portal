@model KnowWaste.Models.MarineDebris
@{
    Layout = "~/Areas/New/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-section text-white text-center d-flex align-items-center justify-content-center">

    <!-- Background Video -->
    <video autoplay muted loop playsinline class="hero-video">
        <source src="~/Content/new-template/images/h1.mp4" type="video/mp4">
    </video>

    <!-- Dark Overlay -->
    <div class="hero-dark-overlay"></div>

    <!-- Content -->
    <div class="hero-overlay">
        <hr class="custom-hr">
        <h1 class="display-5 fw-bold">MARINE DEBRIS</h1>
        <p class="lead">A Threat to Ocean Life</p>
        <hr class="custom-hr">
    </div>

    <img src="~/Content/new-template/imgs/wave.png" class="swiggle-home-img" alt="Wave Divider" />

</section>

<!-- About Section -->
<section class="pt-120 pb-60">
    <div class=container container-md container-lg>

        <h2 class="section-title ">About Marine Debris</h2>
        <p class="text-muted">Marine debris is one of the most critical environmental challenges of our time, threatening biodiversity, harming marine life, and impacting human health and livelihoods across the world. In ASEAN, land-based plastic waste and other forms of debris are major contributors to ocean pollution. We aim to support the ASEAN Regional Action Plan for Combating Marine Debris, providing resources and insights that help integrate waste management strategies with the roadmap’s goals for cleaner, healthier, and more sustainable seas.</p>

    </div>
</section>

<!---good practices -->
<section class="pt-60 pb-60">
    <div class="container">
        <h2 class="section-title">Good Practices</h2>

        <!---blog card section--->
        <div class="blog-card-grid">

            @foreach (ViewModels.GoodPractice item in Model.BlogList.Take(4))
            {
                <a href="New/GoodPractices/Details/@item.ID" class="blog-card">
                    <div class="blog-card-image">
                        <img src="Documents/Blogs/@item.Thumbnail.Split(';')[0]"
                             class="card-img-top"
                             alt="@item.Title">
                    </div>

                    <div class="blog-card-content">
                        <h3>@item.Title</h3>

                        <div class="blog-card-meta meta">
                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                @item.Country
                            </div>
                        </div>

                        <div class="card-text text-truncate-3" style="max-height: 80px">@Html.Raw(item.Description)</div>
                        <span class="blog-card-arrow">→</span>
                    </div>
                </a>
            }
        </div><!---end of card grid ---->
    </div>
    <div class="text-center mt-4">
        <a href="New/GoodPractices" class="btn-main">See all Good Practices</a>
    </div>
</section>
<!--end of good practices-->

<!---3rproma -->
<section class="pt-60 pb-60 bg-peach-cream">
    <div class="container">
        <h2 class="section-title">3RProMAR</h2>

        <!---publication -list --->
        <div class="publication-list home-publication">

            @foreach (ViewModels.Document item in Model._3RProMARList.Take(5))
            {

                <!-- DOCUMENT ITEM -->
                <a href="~/Documents/@item.Attachment.Split(';')[0]" class="publication-item" target="_blank">

                    <div class="publication-image">
                        <img src="/Documents/@item.Thumbnail" alt="@item.Title">
                    </div>

                    <div class="publication-content">
                        <h3 class="publication-title">
                            @item.Title
                        </h3>

                        <div class="publication-meta meta">

                            <div class="meta-item">
                                <i class="bi bi-calendar3 meta-icon"></i>
                                <span>@item.Year</span>
                            </div>

                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                <span>@item.Country</span>
                            </div>

                            <div class="meta-item">
                                <i class="bi bi-building meta-icon"></i>
                                <span>@item.Publisher</span>
                            </div>

                        </div>

                        <p class="publication-desc">
                            The overall objective of the technical guidelines is to prevent plastics leakage...
                        </p>

                        <!-- NOT a link anymore -->
                        <span class="btn-secondary-main">

                            <span>View Document</span>

                            <span class="download-icon">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M12 3V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M5 19H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                            </span>
                        </span>
                    </div>
                </a>
                <!-- END DOCUMENT ITEM -->
            }
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="New/_3rpromar" class="btn-main">See all 3RProMAR Documents</a>
    </div>
</section> 
<!---end of publications -->

<!-- network of practices -->
<section class="bg-ocean">
    <div class="row" id="networks-of-practice" style="background-image: url('Content/marine-debris/shutterstock_436985632.jpg'); background-repeat: no-repeat; background-size: cover; background-color: white; background-attachment: fixed;">
        <div class="col-md-12 py-5" style=" background-color: #00000099; ">
            <div class="container mb-7 text-center py-5">
                <h2 class="section-title">NETWORKS OF PRACTICE</h2>
                <div id="NetworkOfPracticeCarousel" class="carousel slide w-100 py-5" data-bs-ride="carousel" data-bs-interval="3000">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#NetworkOfPracticeCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#NetworkOfPracticeCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <a class="octagon d-flex align-items-center m-auto" style="background-color: #13222c; height: 200px; width: 200px;" href="https://ikhapp.org/">
                                <img src="/Content/marine-debris/ikhapp.svg" class="m-auto w-100" alt="" />
                            </a>
                            <br />
                            <a href="https://ikhapp.org/" class="text-white text-decoration-none fs-5">
                                International Knowledge Hub Against Plastic Pollution
                            </a>
                        </div>

                        <div class="carousel-item">
                            <a class="octagon d-flex align-items-center bg-white m-auto" style="height: 200px; width: 200px;" href="https://rkcmpd-eria.org/">
                                <img src="~/Content/marine-debris/logo-rkc-mpd.png" class="m-auto w-100" alt="" />
                            </a>
                            <br />
                            <a href="https://rkcmpd-eria.org/" class="text-white text-decoration-none fs-5">
                                Regional Knowledge Centre for Marine Plastic Debris
                                RKC-MPD ERIA
                            </a>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#NetworkOfPracticeCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#NetworkOfPracticeCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!---Technology -->
<section class="pt-60 pb-60">
    <div class="container">
        <h2 class="section-title">Technology</h2>

        <!---blog card section--->
        <div class="blog-card-grid">

            @foreach (ViewModels.Technology item in Model.TechnologyList.Take(4))
            {
                <a href="New/Technology/Details/@item.ID" class="blog-card">
                    <div class="blog-card-image">
                        <img src="~/Documents/Technology/@item.Thumbnail.Split(';')[0]"
                             class="card-img-top"
                             alt="@item.Title">
                    </div>

                    <div class="blog-card-content">
                        <h3>@item.Title</h3>

                        <div class="blog-card-meta meta">
                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                @item.Country
                            </div>
                        </div>

                        <div class="card-text text-truncate-3" style="max-height: 80px">@Html.Raw(item.Description)</div>
                        <span class="blog-card-arrow">→</span>
                    </div>
                </a>
            }
        </div><!---end of card grid ---->
    </div>
    <div class="text-center mt-4">
        <a href="New/Technology" class="btn-main">See all Technolgy</a>
    </div>
</section><!--end of good practices-->
    
<!-- E-Learning -->
<section class="pt-120 pb-120">
    <div class="container container-md container-lg">
        <div class="feature-box">

            <!-- LEFT IMAGE -->
            <div class="feature-image">

                <img src="~/Content/new-template/images/elearning.jpg" alt="E-Learning">

                <div class="feature-overlay">
                    <h3>
                        Climate Adaptation<br>
                        & Resilience
                    </h3>

                    <p>
                        Sustainable waste and resource management learning course
                    </p>
                </div>

            </div>

            <!-- RIGHT CARD -->
            <div class="feature-content">

                <span class="feature-tag">
                    Online Learning
                </span>

                <h3>
                    Climate Adaptation and Resilience Building Through Sustainable Waste and Resource Management
                </h3>

                <a href="https://ap-plat.nies.go.jp/adaptation_literacy/resources/e_learning/waste_management/index.html?fbclid=IwAR2zsmf3Qun3CPYvOnuRW38yOvI7bORXqsTF-25pLuqrLiERn_7XOUSjDuo"
                   class="btn-main"
                   target="_blank">
                    Explore Courses
                </a>
            </div>
        </div>
    </div>
</section>

