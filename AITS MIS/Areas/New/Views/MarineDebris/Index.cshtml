                    </div>
                </a>
                <!-- END DOCUMENT ITEM -->
            }
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="New/Publications" class="btn-main">See all Publications</a>
    </div>
</section> <!---end of publications -->

<!-- data -->
<section class="pt-60 pb-60 bg-peach-cream">
    <div class="container container-md container-lg">
        <h2 class="section-title mb-5">Data</h2>
        <div class="feature-box">
            <!-- LEFT IMAGE -->
            <div class="feature-image">
                <img src="~/Content/new-template/images/data.png" alt="data">
                <div class="feature-overlay">
                    <h3>
                        Data
                    </h3>
                </div>
            </div>
            <!-- RIGHT CARD -->
            <div class="feature-content">
                <p>
                    This section compiles and presents waste-related data from across ASEAN, helping stakeholders make evidence-based decisions to address marine litter and improve waste management.
                </p>
                <a href="data.html"
                   class="btn-main"
                   target="_blank">
                    Explore More
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Policy -->
<section class="pt-60 pb-60">
    <div class="container container-md container-lg">
        <h2 class="section-title mb-5">Policy</h2>
        <div class="feature-box">
            <!-- LEFT IMAGE -->
            <div class="feature-image">
                <img src="~/Content/new-template/images/policy.jpg" alt="E-Learning">
                <div class="feature-overlay">
                    <h3>
                        Policy
                    </h3>
                </div>
            </div>
            <!-- RIGHT CARD -->
            <div class="feature-content">
                <p>
                    It presents key laws, regulations, and policy measures addressing waste management and plastic pollution, helping to better understand the policy landscape and identify actions supporting waste reduction, recycling, and marine litter prevention.
                </p>
                <a href="policy.html"
                   class="btn-main"
                   target="_blank">
                    Explore More
                </a>
            </div>
        </div>
    </div>
</section>

<!---expert -->
<section class="pt-60 pb-60 bg-light-blue">
    <div class="container">
        <h2 class="section-title">Meet the Experts</h2>
        <div class="container">
            <div class="owl-carousel owl-theme meet-the-experts expert-grid">
                @foreach (ViewModels.Expert item in Model.ExpertList)
                {
                    <a href="/New/Experts#@item.Name.Replace(" ","")" class="card expert-card mx-2">
                        <div class="expert-image">
                            <img src="Documents/@item.Thumbnail.Split(';')[0]" alt="@item.Name">
                        </div>
                        <div class="expert-content">
                            <h3>@item.Name</h3>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@section scripts{
    <script>
        $(function () {
            $(".networks-of-practice").owlCarousel({
                items: 1,
                loop: true,
                animateOut: 'fadeOut',
                autoplay: true,
                autoplayTimeout: 3000,
                autoplayHoverPause: true,
            });

            $(".meet-the-experts").owlCarousel({
                items: 4,
                loop: true,
                animateOut: 'fadeOut',
                autoplay: true,
                autoplayTimeout: 3000,
                autoplayHoverPause: true,
                responsive: {
                    0: {
                        items: 1
                    },
                    600: {
                        items: 3
                    },
                    1000: {
                        items: 4
                    },
                    1200: {
                        items: 4
                    }
                }
            });
        });
    </script>
}