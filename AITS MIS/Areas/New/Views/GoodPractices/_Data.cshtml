@model KnowWaste.Models.GoodPractices

@if (Model.BlogList.Count == 0)
{
    <div class="w-100 text-center bg-light d-grid p-4 mt-5">There is no information matching your search.</div>
}
else
{
    if (Model.PaginationSetting.TotalPages > 0)
    {
        <div class="d-flex justify-content-end align-items-center mb-5">
            <nav aria-label="Page navigation example" class="pagination">
                <ul class="pagination">
                    <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == 0 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex - 1))">Previous</button></li>
                    @for (int index = 0; index < Model.PaginationSetting.TotalPages; index++)
                    {
                        <li class="page-item"><button class="page-link @(index == Model.PaginationSetting.PageIndex ? "text-dark" : null)" onclick="refreshData(@index)">@(index + 1)</button></li>
                    }
                    <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == Model.PaginationSetting.TotalPages - 1 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex + 1))">Next</button></li>
                </ul>
            </nav>
        </div>
    }

    <div class="blog-card-grid pt-0">
        @foreach (ViewModels.GoodPractice item in Model.BlogList)
        {
            <a href="New/GoodPractices/Details/@item.ID" class="blog-card">
                <div class="blog-card-image">
                    <img src="Documents/Blogs/@item.Thumbnail.Split(';')[0]" alt="">
                </div>

                <div class="blog-card-content">
                    <h3>@item.Title</h3>

                    <div class="blog-card-meta meta">
                        <div class="meta-item">
                            <i class="bi bi-geo-alt meta-icon"></i>
                            @item.Country
                        </div>
                    </div>

                    <div class="card-text text-truncate-3" style="max-height: 80px">@Html.Raw(item.Description)</div>
                    <span class="blog-card-arrow">→</span>
                </div>
            </a>
        }
    </div>

    if (Model.PaginationSetting.TotalPages > 0)
    {
        <div class="d-flex justify-content-end align-items-center mb-5">
            <nav aria-label="Page navigation example" class="pagination">
                <ul class="pagination">
                    <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == 0 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex - 1))">Previous</button></li>
                    @for (int index = 0; index < Model.PaginationSetting.TotalPages; index++)
                    {
                        <li class="page-item"><button class="page-link @(index == Model.PaginationSetting.PageIndex ? "text-dark" : null)" onclick="refreshData(@index)">@(index + 1)</button></li>
                    }
                    <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == Model.PaginationSetting.TotalPages - 1 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex + 1))">Next</button></li>
                </ul>
            </nav>
        </div>
    }
}