@model ViewModels.News
@{
    Layout = "~/Areas/New/Views/Shared/_Layout.cshtml";
}
<section class="page-banner news">
    <div class="banner-content">
        <h1>News</h1>
        <p></p>

    </div>

    <svg class="banner-wave" viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path fill="#f5fbfe" d="M0,80 C360,140 1080,0 1440,80 L1440,120 L0,120 Z"></path>
    </svg>

</section>
<!---end of page banner--->
<!--blog -->
<!-- BLOG ARTICLE -->
<section class="bg-blue">

    <!-- article -->
    <div class="container blog-article-container pb-120  pt-120">

        <!-- article header -->
        <div class="article-header">

            <h2 class="section-title mb-4">
                @Model.Title
            </h2>

            <!-- meta + share -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <!-- article meta -->
                <div class="article-meta">

                    <div class="meta-item">
                        <i class="bi  bi-geo-alt-fill"></i>
                        <span>@Model.Country</span>
                    </div>

                    <div class="meta-item">
                        <i class="bi bi-calendar3"></i>
                        <span>@Convert.ToDateTime(Model.Date.Split('-')[0]).ToString("d MMMM yyyy")</span>
                    </div>
                </div>


                <!-- share -->
                <div class="d-flex align-items-center gap-3">

                    <span class="fw-semibold text-muted small">
                        Share:
                    </span>

                    <div class="article-share">
                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-envelope"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- article content -->
        <div class="blog-content">
            <!-- section -->
            <div class="content-section">
                @Html.Raw(Model.Description)
            </div>
        </div>

        <!--gallery-->
        <div class="article-gallery-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="section-title m-0">
                    Event Gallery
                </h2>
                <div class="article-gallery-nav">
                    <div class="article-gallery-prev">
                        <i class="bi bi-arrow-left"></i>
                    </div>
                    <div class="article-gallery-next">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </div>

            <!-- swiper -->
            <div class="swiper article-gallery-swiper">
                <div class="swiper-wrapper">
                    @foreach (string item in Model.Photo.Split(';'))
                    {
                        <!-- slide -->
                        <div class="swiper-slide">
                            <div class="article-gallery-card">
                                <img src="Documents/News/@item" alt="">
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>




<!-- news-list Section -->
<section class="pt-120 pb-60 bg-light-blue">
    <div class="container ">
        <div class="pb-4">
            <h2 class="section-title mb-4">Read More News</h2>
        </div>

        <!---blog card section--->
        <div class="blog-card-grid">
            @foreach (ViewModels.News item in Model.RelatedNews.Take(4))
            {
                <a href="New/News/Details/@item.ID" class="blog-card">
                    <div class="blog-card-image">
                        <img src="Documents/News/@item.Photo.Split(';')[0]"
                             class="card-img-top"
                             alt="@item.Title">
                    </div>

                    <div class="blog-card-content">
                        <h3>@item.Title</h3>

                        <div class="blog-card-meta meta">
                            <div class="meta-item">
                                <i class="bi bi-geo-alt meta-icon"></i>
                                @item.Country
                            </div>
                        </div>

                        <div class="card-text text-truncate-3" style="max-height: 80px">@Html.Raw(item.Description)</div>
                        <span class="blog-card-arrow">→</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>