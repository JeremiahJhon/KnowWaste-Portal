@model KnowWaste.Models.News
@{
    Layout = "~/Areas/New/Views/Shared/_Layout.cshtml";
}

<section class="page-banner news">
    <div class="banner-content">
        <h1>News</h1>
    </div>
    <svg class="banner-wave" viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path fill="#ffffff"
              d="M0,80 C360,140 1080,0 1440,80 L1440,120 L0,120 Z"></path>
    </svg>
</section>
<!---end of page banner--->

<section class="breadcrumb">
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item text-uppercase"><a href="New/MarineDebris">Marine Debris</a></li>
                <li class="breadcrumb-item active text-uppercase" aria-current="page">News</li>
            </ol>
        </nav>
    </div>
</section>

<!--- NEWS HIGHLIGHT SECTION -->
<section class="ptb-60 news-highlight">
    <div class="custom-container">
        <div class="news-highlight-inner">
            <div id="carouselExampleCaptions"
                 class="carousel slide carousel-fade news-carousel"
                 data-bs-ride="carousel"
                 data-bs-interval="3000">

                <!-- 🔥 WRAPPER (important for positioning) -->
                <div class="carousel-wrapper">

                    <!-- SLIDES -->
                    <div class="carousel-inner">
                        @foreach (ViewModels.Event item in Model.EventsList.Take(3))
                        {
                            <div class="carousel-item active">
                                <div class="news-highlight-card">

                                    <div class="news-image">
                                        <img src="~/Documents/News/@item.Thumbnail.Split(';')[0]" alt="">
                                    </div>

                                    <div class="news-content">
                                        <h6 class="news-tag text-uppercase">Latest News</h6>

                                        <h3>
                                            @item.Title
                                        </h3>

                                        <div class="news-meta">

                                            <div class="meta-item">
                                                <i class="bi bi-calendar3 meta-icon"></i>
                                                <span>@Convert.ToDateTime(item.StartDate.Split('-')[0]).ToString("d MMMM yyyy")</span>
                                            </div>

                                            <div class="meta-item">
                                                <i class="bi bi-geo-alt meta-icon"></i>
                                                <span>@item.Country</span>
                                            </div>

                                        </div>

                                        <div class="text-truncate-3" style="max-height: 70px">@Html.Raw(item.Description)</div>

                                        <a href="New/News/Details/@item.ID" class="btn-main">
                                            Read More →
                                        </a>
                                    </div>

                                </div>
                            </div>
                        }
                        @foreach (ViewModels.News item in Model.NewsList.Take(3))
                        {
                            <div class="carousel-item active">
                                <div class="news-highlight-card">

                                    <div class="news-image">
                                        <img src="~/Documents/News/@item.Photo.Split(';')[0]" alt="">
                                    </div>

                                    <div class="news-content">
                                        <h6 class="news-tag text-uppercase">Latest News</h6>

                                        <h3>
                                            @item.Title
                                        </h3>

                                        <div class="news-meta">

                                            <div class="meta-item">
                                                <i class="bi bi-calendar3 meta-icon"></i>
                                                <span>@Convert.ToDateTime(item.Date.Split('-')[0]).ToString("d MMMM yyyy")</span>
                                            </div>

                                            <div class="meta-item">
                                                <i class="bi bi-geo-alt meta-icon"></i>
                                                <span>@item.Country</span>
                                            </div>

                                        </div>

                                        <div class="text-truncate-3" style="max-height: 70px">@Html.Raw(item.Description)</div>

                                        <a href="New/News/Details/@item.ID" class="btn-main">
                                            Read More →
                                        </a>
                                    </div>

                                </div>
                            </div>
                        }
                        <!-- 🔥 SINGLE GLOBAL TIMELINE -->
                        <div class="news-timeline">

                            <div class="news-timeline-item active" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0">
                                <div class="news-timeline-bar">
                                    <div class="news-timeline-progress"></div>
                                </div>
                            </div>

                            <div class="news-timeline-item active" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1">
                                <div class="news-timeline-bar">
                                    <div class="news-timeline-progress"></div>
                                </div>
                            </div>
                            <div class="news-timeline-item" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2">
                                <div class="news-timeline-bar">
                                    <div class="news-timeline-progress"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--- END NEWS HIGHLIGHT SECTION -->
<!---blog-card section--->
<section class="container ptb-5">
    <div class="d-flex justify-content-between align-items-center float-start w-50">
        <form class="d-flex w-100">
            <input class="form-control me-2" type="search" placeholder="🔍  What are you looking for?" aria-label="Search" id="searchInput">
        </form>
    </div>
    <div class="wrapper" id="NewsData">

    </div>
</section>

@if (Model.EventsList.Count > 0)
{
    <!-- About Section -->
    <section class="ptb-60 d-none" hidden>
        <div class="container  container-md container-lg">

            <div class="row custom-padding">
                <div id="carouselExampleCaptions" class="carousel slide col-12 col-md-8 @(Model.EventsList.Count > 0 ? "col-lg-9" : "col-lg-12")">
                    <div class="carousel-indicators">
                        @foreach (ViewModels.News item in Model.NewsList.Take(3))
                        {
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="@Model.NewsList.IndexOf(item)" @(Model.NewsList.IndexOf(item) == 0 ? "class=active aria-current=true" : null) aria-label="Slide @item.ID"></button>
                        }
                    </div>
                    <div class="carousel-inner ">
                        @foreach (ViewModels.News item in Model.NewsList.Take(3))
                        {
                            <a href="New/News/Details/@item.ID" class="text-decoration-none text-dark">
                                <div class="carousel-item @(Model.NewsList.IndexOf(item) == 0 ? "active" : null) h-510">
                                    <img src="~/Documents/News/@item.Photo.Split(';')[0]" class="d-block w-100" alt="..." style="width: 100%; height: 100%; object-fit: cover;">
                                    <div class="carousel-caption d-none d-md-block" style="background-color: rgba(0, 0, 0, 0.5); padding: 12px; text-align: start;">
                                        <h6 class="text-blue text-uppercase">Latest News</h6>
                                        <h4 class="text-white">@item.Title</h4>
                                        <small class="text-white">@item.Country</small>
                                        <br />
                                        <span class="btn btn-link px-0 text-white mt-2">Start Reading →</span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
                @if (Model.EventsList.Count > 0)
                {
                    <div class="col-12 col-md-4 col-lg-3 custom-border p-0 bg-offgrey h-510 vertical-scroll">
                        <h5 class="bg-white" style="padding: 12px 20px; border-left: 5px solid #0FB4DF; border-radius: 8px 8px 0px 0px;">Upcoming events</h5>
                        <div class="wrapper px-3">
                            @foreach (ViewModels.Event item in Model.EventsList)
                            {
                                <div class="custom-border p-2 mb-4 bg-white">
                                    <h6 class="m-0">@item.Title</h6>
                                    <small>@Convert.ToDateTime(item.StartDate.Split('-')[0]).ToString("d MMMM yyyy")</small><br>
                                    <small>@item.Location</small>
                                    <div class="pt-3 text-truncate-3" style="display: -webkit-box; -webkit-line-clamp: 4;  -webkit-box-orient: vertical; overflow: hidden; ">@Html.Raw(item.Description)</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
else
{
    <!-- About Section -->
    <section class="pb-60 d-none" hidden>
        <div class="row custom-padding">
            <div id="carouselExampleCaptions" class="carousel slide col-12 col-md-8 @(Model.EventsList.Count > 0 ? "col-lg-9" : "col-lg-12")">
                <div class="carousel-indicators">
                    @foreach (ViewModels.News item in Model.NewsList.Take(3))
                    {
                        <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="@Model.NewsList.IndexOf(item)" @(Model.NewsList.IndexOf(item) == 0 ? "class=active aria-current=true" : null) aria-label="Slide @item.ID"></button>
                    }
                </div>
                <div class="carousel-inner ">
                    @foreach (ViewModels.News item in Model.NewsList.Take(3))
                    {
                        <a href="New/News/Details/@item.ID" class="text-decoration-none text-dark">
                            <div class="carousel-item @(Model.NewsList.IndexOf(item) == 0 ? "active" : null) h-510">
                                <img src="~/Documents/News/@item.Photo.Split(';')[0]" class="d-block w-100" alt="..." style="width: 100%; height: 100%; object-fit: cover;">
                                <div class="carousel-caption d-none d-md-block hover-zoom" style="background-color: rgba(0, 0, 0, 0.5); padding: 12px; text-align: start;">
                                    <h6 class="text-blue text-uppercase">Latest News</h6>
                                    <h4 class="text-white">@item.Title</h4>
                                    <small class="text-white">@item.Country</small>
                                    <br />
                                    <span class="btn btn-link px-0 text-white mt-2">Start Reading →</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </section>
}

<section class="ptb-30 d-none" hidden>
    <div class="container">
        <h4 class="text-blue mb-4">All News</h4>
        <!-- <hr class="mb-3"> -->
        <div class="row g-4 gy-5">
            @foreach (ViewModels.News item in Model.NewsList)
            {
                <div class="col-md-4 px-3">
                    <a href="New/News/Details/@item.ID" class="text-decoration-none text-dark">
                        <div class="card h-100 card-rounded s-border box-shadow m-10 hover-zoom-card">
                            <img src="~/Documents/News/@item.Photo.Split(';')[0]" class="card-img-top" alt="@item.Title" style="height: 250px; width: 100%; object-fit: cover;">
                            <div class="card-body p-4">
                                <h5 class="card-title">@item.Title</h5>
                                <small>@item.Country</small>
                                <div class="card-text text-truncate-3">@Html.Raw(item.Description)</div>
                                <span class="btn btn-link px-0 mt-2">Start Reading →</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@section scripts {
    <script>
        $(document).ready(function () {
            refreshData(0);

            $("#searchInput").keyup(function () {
                refreshData(0);
            });
        });

        function refreshData(pageIndex) {
            const searchText = $("#searchInput").val();
            const url = `/New/News/RefreshData?searchText=${searchText}&pageIndex=${pageIndex}`;
            const data = [];
            $("#NewsData").load(url);
        }
    </script>
}