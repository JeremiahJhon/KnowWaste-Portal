@model KnowWaste.Models.Documents
@{
    Layout = "~/Areas/New/Views/Shared/_Layout.cshtml";
}
<section class="page-banner publication">

    <div class="banner-content">
        <h1>Thematic Area</h1>
        <p></p>
    </div>

    <svg class="banner-wave" viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path fill="#ffffff"
              d="M0,80 C360,140 1080,0 1440,80 L1440,120 L0,120 Z"></path>
    </svg>

</section>

<section class="breadcrumb">
    <div class=" container container-md container-lg py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item text-uppercase"><a href="#">Topic</a></li>
                <li class="breadcrumb-item active text-uppercase" aria-current="page">Thematic Area</li>
            </ol>
        </nav>
    </div>
</section>

<!-- About Section -->
<section class="ptb-5 ">
    <div class="container pb-120">
        <div class="text-center pb-4" hidden>
            <p class="text-muted text-start">It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout. The point of using Lorem Ipsum is that it has a more-or-less </p>
        </div>
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3">
                <div class="mb-4 custom-sidebar ">
                    <strong class="m-0 pe-3" style="padding-bottom: 4px;">Thematic Areas </strong>
                    @foreach (string area in Model.Areas)
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input area-select" type="radio" name="radioArea" data-val="@area" @(Model.Areas.IndexOf(area) == 0 ? "checked" : "")>
                            <label class="form-check-label">
                                @area
                            </label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12 col-md-8 col-lg-9">
                <div class="wrapper">
                    <div class="wrapper col-3 ms-2 float-end" style="position: relative; z-index: 999;">
                        <input class="form-control me-2" type="search" placeholder="Search..." aria-label="Search" id="searchInput">
                    </div>
                    <div class="document-list" id="ThematicAreaData" style="position: relative; top: -40px;">

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section scripts {
    <script>
        $(document).ready(function () {
            refreshData(0);

            $(".area-select").change(function () {
                refreshData(0);
            });

            $("#searchInput").on("keyup", function () {
                refreshData(0);
            });
        });

        function refreshData(pageIndex) {
            const area = encodeURI($(".area-select:checked").data("val").toString());
            const searchText = $("#searchInput").val();
            const url = `/New/ThematicArea/RefreshData?area=${area}&searchText=${searchText}&pageIndex=${pageIndex}`;
            const data = [];
            $("#ThematicAreaData").load(url);
        }
    </script>
}