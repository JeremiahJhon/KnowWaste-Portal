@model KnowWaste.Models.Documents

<h3 class="section-title mb-0 text-uppercase text-start">@Model.Area</h3>

@if (Model.PaginationSetting.TotalPages > 0)
{
    <div class="d-flex justify-content-end align-items-center mb-0">
        <nav aria-label="Page navigation example" class="pagination">
            <ul class="pagination">
                <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == 0 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex - 1))">Previous</button></li>
                @for (int index = 0; index < Model.PaginationSetting.TotalPages; index++)
                {
                    <li class="page-item"><button class="page-link @(index == Model.PaginationSetting.PageIndex ? "text-dark" : null)" onclick="refreshData(@index)">@(index + 1)</button></li>
                }
                <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == Model.PaginationSetting.TotalPages - 1 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex + 1))">Next</button></li>
            </ul>
        </nav>
    </div>
}

@foreach (ViewModels.Document item in Model.DocumentList)
{
    <div class="document-item">
        <div class="document-content">
            <h3 class="document-title">
                @item.Title
            </h3>
            <div class="document-meta meta">
                <div class="meta-item">
                    <i class="bi bi-calendar3 meta-icon"></i>
                    <span>@item.Year</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-geo-alt meta-icon"></i>
                    <span>@item.Country</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-building meta-icon"></i>
                    <span>@item.Publisher</span>
                </div>
            </div>
            <div class="document-desc">
                @Html.Raw(item.Description)
            </div>
            <div class="document-actions">
                <a href="Documents/@item.Attachment.Split(';')[0]" class="btn-secondary-main" target="_blank" @(String.IsNullOrWhiteSpace(item.Attachment.Split(';')[0]) ? "hidden" : null) )>
                    Download
                    <span class="download-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 3V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M5 19H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                    </span>
                </a>
                <a href="@item.Source.Split(';')[0]" class="btn-secondary-main" target="_blank" @(String.IsNullOrWhiteSpace(item.Source) ? "hidden" : null) @(String.IsNullOrWhiteSpace(item.Source.Split(';')[0]) ? "hidden" : null) )>
                    View Source
                    <span class="source-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M14 5H19V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M10 14L19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M19 14V19H5V5H10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
}

@if (Model.PaginationSetting.TotalPages > 0)
{
    <div class="d-flex justify-content-end align-items-center mb-5">
        <nav aria-label="Page navigation example" class="pagination">
            <ul class="pagination">
                <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == 0 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex - 1))">Previous</button></li>
                @for (int index = 0; index < Model.PaginationSetting.TotalPages; index++)
                {
                    <li class="page-item"><button class="page-link @(index == Model.PaginationSetting.PageIndex ? "text-dark" : null)" onclick="refreshData(@index)">@(index + 1)</button></li>
                }
                <li class="page-item"><button class="page-link" @(Model.PaginationSetting.PageIndex == Model.PaginationSetting.TotalPages - 1 ? "hidden" : null) onclick="refreshData(@(Model.PaginationSetting.PageIndex + 1))">Next</button></li>
            </ul>
        </nav>
    </div>
}