@model KnowWaste.Models.Technology
@{
    Layout = "~/Areas/New/Views/Shared/_Layout.cshtml";
}
<section class="page-banner technology">
    <div class="banner-content">
        <h1>Technology</h1>
        <p></p>

    </div>

    <svg class="banner-wave" viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path fill="#ffffff"
              d="M0,80 C360,140 1080,0 1440,80 L1440,120 L0,120 Z"></path>
    </svg>

</section>

<section class="breadcrumb">
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item text-uppercase"><a href="New/MarineDebris">Marine Debris</a></li>
                <li class="breadcrumb-item active text-uppercase" aria-current="page">Technology</li>
            </ol>
        </nav>
    </div>
</section>

<!-- About Section -->
<section>
    <div class="container pb-120">
        <div class=" pb-4">
            <p>
                This section features innovative technological solutions that can transform waste management and reduce marine litter across ASEAN. From community-based recycling systems to cutting-edge industrial technologies, these examples demonstrate how technology can drive sustainable change. If you would like to showcase your technology on this page and help inspire others, please email us at warm@rrcap.ait.ac.th. We welcome your contributions.
            </p>

        </div>
        <div class="d-flex align-items-center pb-3">
            <p class="m-0 pe-3">Filter by Country</p>
            <select class="form-select" id="countrySelect" onclick="refreshData(0)" style="width: 30%;">
                <option selected value="0">All</option>
                @foreach (ViewModels.Country country in Model.Countries)
                {
                    <option value="@country.ID">@country.Name</option>
                }
            </select>
        </div>
        <div class="wrapper col-3 float-start">
            <input class="form-control me-2" type="search" placeholder="Search..." aria-label="Search" id="searchInput">
        </div>
        <!---blog card section--->
        <div class="wrapper" id="TechnologyData">

        </div><!---end of card grid ---->
    </div>
</section>
@section scripts {
    <script>
        $(document).ready(function () {
            refreshData(0);

            $("#searchInput").keyup(function () {
                refreshData(0);
            });
        });

        function refreshData(pageIndex) {
            const countryID = $("#countrySelect").val();
            const searchText = $("#searchInput").val();
            const url = `/New/Technology/RefreshData?countryID=${countryID}&searchText=${searchText}&pageIndex=${pageIndex}`;
            const data = [];
            $("#TechnologyData").load(url);
        }
    </script>
}