@foreach (ViewModels.Policy item in policies)

{
    if (policies.IndexOf(item) != 0)
    {
        <hr class="mt-0" />
    }
    <div class="accordion-item custom-accordion-item">
        <div>
            <button class="accordion-button bg-white @(policies.IndexOf(item) == 0 ? "" : "collapsed") px-0 d-block py-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@(policies.IndexOf(item) + 1)" aria-expanded="@(policies.IndexOf(item) == 0 ? "true" : "false")" aria-controls="collapse_@(policies.IndexOf(item) + 1)">
                <h5 class="accordion-header ">
                    <strong>@item.Legal</strong>
                </h5>
                <div class="text-muted">@item.Country</div>
                <div class="text-muted">@item.Year</div>
            </button>
        </div>
        <div id="collapse_@(policies.IndexOf(item) + 1)" class="accordion-collapse collapse @(policies.IndexOf(item) == 0 ? "show" : "")">
            <div class="accordion-body bg-white px-0 text-muted">
                @Html.Raw(item.Description)
            </div>
        </div>
    </div>
}