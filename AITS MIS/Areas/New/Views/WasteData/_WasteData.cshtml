@model KnowWaste.Models.WasteData
@{
    var data = Model.DataList
   .GroupBy(x => new
   {
       x.CountryID,
       x.Country,
       x.WasteTypeID,
       x.WasteType,
       x.Year
   })
    .Select(g => new ViewModels.WasteData
    {
        Country = g.Key.Country, //add
        WasteCategory = g.Key.WasteType,

        Year = g.Key.Year,
        Generated = g.All(x => x.TotalGenerated == null) ? (decimal?)null : g.Sum(x => x.TotalGenerated ?? 0),
        Hazardous = g.All(x => x.Hazardous == null) ? (decimal?)null : g.Sum(x => x.Hazardous ?? 0),
        Collected = g.All(x => x.TotalCollected == null) ? (decimal?)null : g.Sum(x => x.TotalCollected ?? 0),
        Recycled = g.All(x => x.Recycled == null) ? (decimal?)null : g.Sum(x => x.Recycled ?? 0),
        Recovered = g.All(x => x.Recovered == null) ? (decimal?)null : g.Sum(x => x.Recovered ?? 0),
        Disposal = g.All(x => x.Disposal == null) ? (decimal?)null : g.Sum(x => x.Disposal ?? 0),
        Treatment = g.All(x => x.Treatment == null) ? (decimal?)null : g.Sum(x => x.Treatment ?? 0),
        Reuse = g.All(x => x.Reuse == null) ? (decimal?)null : g.Sum(x => x.Reuse ?? 0),
        Sludge = g.All(x => x.Sludge == null) ? (decimal?)null : g.Sum(x => x.Sludge ?? 0),

        Ref = string.Join(", ",
            g.Select(x => x.Reference)
             .Where(r => !string.IsNullOrEmpty(r))
             .Distinct()
        )
    })
    .OrderBy(x => x.Country)
        .ThenBy(x => x.WasteCategory)
        .ThenByDescending(x => x.Year)
        .ToList();


}

<table class="table" id="WasteDataTable">
    <thead>
        <tr>
            @if (Model.CountryID == 0)
            {
                <th>Country</th>
            }
            <th scope="col">Waste Category</th>
            <th scope="col">Year</th>
            <th scope="col" class="text-end">Generated</th>
            <th scope="col" class="text-end">Hazardous</th>
            <th scope="col" class="text-end">Collected</th>
            <th scope="col" class="text-end">Recycled</th>
            <th scope="col" class="text-end">Recovered</th>
            <th scope="col" class="text-end">Disposal</th>
            <th scope="col" class="text-end">Treatment</th>
            <th scope="col" class="text-end">Reuse</th>
            <th scope="col" class="text-end">Sludge</th>
            <th scope="col">Ref</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ViewModels.WasteData item in data)
        {
            <tr>
                <!-- <th scope="row">1</th> -->
                @if (Model.CountryID == 0)
                {
                    <td>@item.Country</td>
                }
                <td>@item.WasteCategory</td>
                <td>@item.Year</td>
                <td align="right">@(item.Generated.HasValue ? item.Generated.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Hazardous.HasValue ? item.Hazardous.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Collected.HasValue ? item.Collected.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Recycled.HasValue ? item.Recycled.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Recovered.HasValue ? item.Recovered.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Disposal.HasValue ? item.Disposal.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Treatment.HasValue ? item.Treatment.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Reuse.HasValue ? item.Reuse.Value.ToString("#,##0.#0") : "-")</td>
                <td align="right">@(item.Sludge.HasValue ? item.Sludge.Value.ToString("#,##0.#0") : "-")</td>
                <td>
                    @if (!String.IsNullOrWhiteSpace(item.Ref))
                    {
                        <div hidden="">
                            <div data-name="popover-content-@data.IndexOf(item)" style="font-size: 10px; max-height: 500px; overflow: auto;">
                                @Html.Raw(item.Ref)
                            </div>
                        </div>
                        <button id="ref-@data.IndexOf(item)" type="button" class="btn btn-primary popover-group py-1 px-2 border" data-bs-toggle="tooltip" data-bs-trigger="focus" data-bs-placement="right" style="border-radius: 20px;position:relative;margin:-10px 0px;">
                            <i class="bi bi-info-lg px-0"></i>
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>